{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "scout.washu.edu/v1alpha1",
      "description": "Catalog schema version. Documents with any other value are skipped."
    },
    "chips": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Chip heading, at most 60 characters"
          },
          "description": {
            "default": "",
            "description": "One line about the destination",
            "type": "string",
            "maxLength": 200
          },
          "icon": {
            "default": "app",
            "type": "string",
            "enum": [
              "academic-cap",
              "app",
              "archive",
              "beaker",
              "bell",
              "book-open",
              "calendar",
              "chart",
              "chart-bar",
              "chat",
              "clipboard-check",
              "clock",
              "cloud",
              "cog",
              "collection",
              "cube",
              "database",
              "docker",
              "document-text",
              "download",
              "external-link",
              "eye",
              "film",
              "folder",
              "github",
              "globe",
              "grafana",
              "heart",
              "jupyter",
              "key",
              "kubernetes",
              "lightning-bolt",
              "link",
              "mail",
              "minio",
              "photograph",
              "postgresql",
              "puzzle",
              "python",
              "search",
              "server",
              "shield-check",
              "sparkles",
              "table",
              "temporal",
              "terminal",
              "upload",
              "user-group"
            ]
          },
          "iconData": {
            "description": "Embedded image data URI; wins over icon",
            "type": "string",
            "maxLength": 16384,
            "pattern": "^data:image\\/(?:png|jpeg|svg\\+xml);base64,[A-Za-z0-9+/]+={0,2}$"
          },
          "tone": {
            "default": "indigo",
            "type": "string",
            "enum": [
              "indigo",
              "emerald",
              "amber",
              "violet",
              "rose",
              "cyan",
              "red",
              "orange",
              "slate"
            ]
          },
          "link": {
            "type": "object",
            "properties": {
              "subdomain": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
              },
              "path": {
                "type": "string",
                "pattern": "^\\/.*"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "description": "Exactly one destination: subdomain (with optional path suffix), path, or url"
          },
          "newTab": {
            "default": true,
            "type": "boolean"
          },
          "group": {
            "default": "more",
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "weight": {
            "default": 100,
            "description": "Lower renders first",
            "type": "number"
          },
          "audience": {
            "default": "user",
            "type": "string",
            "enum": [
              "user",
              "admin"
            ]
          },
          "enabled": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "link"
        ]
      }
    },
    "groups": {
      "default": [],
      "description": "Define a group only when introducing a new section",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Section heading, at most 60 characters"
          },
          "description": {
            "default": "",
            "type": "string",
            "maxLength": 200
          },
          "icon": {
            "default": "folder",
            "type": "string",
            "enum": [
              "academic-cap",
              "app",
              "archive",
              "beaker",
              "bell",
              "book-open",
              "calendar",
              "chart",
              "chart-bar",
              "chat",
              "clipboard-check",
              "clock",
              "cloud",
              "cog",
              "collection",
              "cube",
              "database",
              "docker",
              "document-text",
              "download",
              "external-link",
              "eye",
              "film",
              "folder",
              "github",
              "globe",
              "grafana",
              "heart",
              "jupyter",
              "key",
              "kubernetes",
              "lightning-bolt",
              "link",
              "mail",
              "minio",
              "photograph",
              "postgresql",
              "puzzle",
              "python",
              "search",
              "server",
              "shield-check",
              "sparkles",
              "table",
              "temporal",
              "terminal",
              "upload",
              "user-group"
            ]
          },
          "weight": {
            "default": 100,
            "description": "Section order on the page",
            "type": "number"
          },
          "layout": {
            "default": "cards",
            "type": "string",
            "enum": [
              "cards",
              "rows",
              "tiles"
            ]
          },
          "maxColumns": {
            "description": "Defaults by layout: cards 3, tiles 2, rows 1",
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "width": {
            "default": "full",
            "type": "string",
            "enum": [
              "full",
              "half"
            ]
          },
          "audience": {
            "default": "user",
            "type": "string",
            "enum": [
              "user",
              "admin"
            ]
          },
          "footerLink": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "text",
              "url"
            ]
          }
        },
        "required": [
          "id",
          "title"
        ]
      }
    }
  },
  "required": [
    "apiVersion"
  ],
  "description": "Scout launchpad catalog document (ADR 0034)"
}
