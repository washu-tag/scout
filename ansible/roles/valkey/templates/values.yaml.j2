auth:
  enabled: true
  usersExistingSecret: '{{ valkey_helm_release_name }}-auth'
  # Each user's permissions string is combined with its password to generate the ACL:
  #   user <username> on #<password_hash> <permissions_string>
  # See https://valkey.io/topics/acl/
  aclUsers: {{ valkey_acl_users | to_json }}

service:
  type: ClusterIP
  port: 6379

dataStorage:
  enabled: {{ valkey_persistence_enabled | lower }}
{% if valkey_storage_size %}
  requestedSize: {{ valkey_storage_size }}
{% endif %}
{% if valkey_storage_class %}
  className: {{ valkey_storage_class }}
{% endif %}
{% if valkey_persistence_enabled | bool %}

# One replica on a ReadWriteOnce volume: a RollingUpdate surge pod waits on the volume
# the old pod holds, so the Helm upgrade times out. Recreate frees it first.
deploymentStrategy: Recreate
{% endif %}

resources: {{ valkey_resources_default | combine(valkey_resources | default({}), recursive=true) | to_json }}

valkeyConfig: |
{{ valkey_config | indent(2, first=true) }}

metrics:
  enabled: true
  exporter:
    extraExporterSecrets:
      - name: '{{ valkey_helm_release_name }}-auth'
    extraVolumeMounts:
      - name: '{{ valkey_helm_release_name }}-auth-exporter'
        mountPath: /valkey-auth
        readOnly: true
    args:
      - '--redis.password-file=/valkey-auth/password-file'
  serviceMonitor:
    enabled: false
