image:
  repository: "{{ superset_image_repository }}"
  tag: "{{ superset_image_tag }}"
redis:
  # Disable embedded Redis - using centralized Valkey instance instead
  enabled: false
extraEnvRaw:
  - name: REDIS_PASSWORD
    valueFrom:
      secretKeyRef:
        name: superset-valkey-auth
        key: REDIS_PASSWORD
extraSecretEnv:
  SUPERSET_SECRET_KEY: "{{ superset_secret }}"
  # superset_svc client_credentials — used by DB_CONNECTION_MUTATOR (below)
  # to mint a JWT for every Trino connection; impersonation of the logged-in
  # user happens via the X-Trino-User header on the same connection. All
  # four entries are kept in the *secret* env block so they land in
  # `superset-env` Secret — the scout-dashboards import Job loads that
  # Secret via envFrom and needs the same values to mint a token during
  # dashboard-import dataset validation.
  KEYCLOAK_SUPERSET_SVC_CLIENT_SECRET: "{{ keycloak_superset_svc_client_secret }}"
  # Internal in-cluster URL for service-to-service token minting --
  # bypasses Traefik + the external cert. The user-facing OAuth flow
  # still uses keycloak_oidc_token_url (the external HTTPS URL) via
  # the SUPERSET_OAUTH_USER_INFO_URL / etc. block below.
  KEYCLOAK_TOKEN_URL: "{{ keycloak_internal_token_url }}"
  KEYCLOAK_SUPERSET_SVC_CLIENT_ID: "superset_svc"
  TRINO_CA_CERT: /etc/trino-ca/ca.crt
ingress:
  enabled: true
  ingressClassName: traefik
  annotations:
    traefik.ingress.kubernetes.io/router.middlewares: >-
      kube-system-oauth2-proxy-error@kubernetescrd,
      kube-system-oauth2-proxy-auth@kubernetescrd,
      kube-system-security-headers@kubernetescrd
  path: /
  hosts:
    - "superset.{{ server_hostname }}"
postgresql:
  enabled: false
supersetNode:
  connections:
    db_host: "{{ db_host }}"
    db_port: "{{ db_port }}"
    db_user: "{{ superset_postgres_user }}"
    db_pass: "{{ superset_postgres_password }}"
    db_name: "{{ superset_database }}"
    redis_host: "{{ valkey_helm_release_name }}.{{ valkey_namespace }}"
    redis_port: "6379"
    # This is needed to trigger the chart's template condition that includes the password in Redis URLs
    # It will get overwritten at runtime with the REDIS_PASSWORD env from the secret
    redis_password: "placeholder"
    redis_cache_db: "0"
    redis_celery_db: "0"
  resources: {{ superset_resources_default | combine(superset_resources | default({}), recursive=true) | to_json }}
  extraContainers:
    - name: statsd-exporter
      image: "{{ superset_statsd_exporter_image }}:{{ superset_statsd_exporter_tag }}"
      args:
        - --statsd.listen-udp=:{{ superset_statsd_port }}
        - --statsd.listen-tcp=
        - --web.listen-address=:{{ superset_statsd_metrics_port }}
        - --statsd.mapping-config=/etc/statsd-exporter/statsd_mapping.yaml
      ports:
        - name: statsd-udp
          containerPort: {{ superset_statsd_port }}
          protocol: UDP
        - name: metrics
          containerPort: {{ superset_statsd_metrics_port }}
          protocol: TCP
      resources: {{ superset_statsd_resources_default | combine(superset_statsd_resources | default({}), recursive=true) | to_json }}
      volumeMounts:
        - name: statsd-mapping
          mountPath: /etc/statsd-exporter
          readOnly: true
configOverrides:
  branding: |
    APP_NAME = "{{ superset_app_name }}"
    APP_ICON = "/static/assets/images/scout.png"
    APP_ICON_WIDTH = {{ superset_logo_width }}
    LOGO_TARGET_PATH = "https://{{ server_hostname }}"
    LOGO_TOOLTIP = "Scout Launchpad"
    FAVICONS = [{"href": "/static/assets/images/favicon.ico"}]
  custom_routing: |
    from flask import redirect, url_for
    from flask_appbuilder import expose, IndexView

    from superset.superset_typing import FlaskResponse

    class SupersetIndexView(IndexView):
        @expose("/")
        def index(self) -> FlaskResponse:
            return redirect(url_for("Superset.dashboard", dashboard_id_or_slug="scout"))

    FAB_INDEX_VIEW = f"{SupersetIndexView.__module__}.{SupersetIndexView.__name__}"
  sql_alchemy: |
    SQLALCHEMY_ENGINE_OPTIONS = {
        "pool_size": {{ superset_pool_size }},
        "max_overflow": {{ superset_pool_max_overflow }},
        "pool_timeout": {{ superset_pool_timeout }},
    }
  enable_oauth: |
    from flask_appbuilder.security.manager import AUTH_OAUTH
    from flask_appbuilder.security.views import AuthOAuthView, expose
    from superset.security import SupersetSecurityManager
    from superset.errors import ErrorLevel, SupersetError, SupersetErrorType
    from superset.exceptions import SupersetSecurityException
    from flask import g, redirect, session, request, jsonify
    import hmac
    import logging
    OAUTH_PROVIDERS = OPENID_PROVIDERS = [
        {
            "name": "keycloak",
            "icon": "fa-key",
            "token_key": "access_token",
            "remote_app": {
                "client_id": "{{ keycloak_superset_client_id }}",
                "client_secret": "{{ keycloak_superset_client_secret }}",
                "client_kwargs": {"scope": "openid microprofile-jwt"},
                "api_base_url": "{{ keycloak_realm_url }}/protocol/",
                "access_token_url": "{{ keycloak_oidc_token_url }}",
                "authorize_url": "{{ keycloak_oidc_auth_url }}",
                "jwks_uri": "{{ keycloak_oidc_certs_url }}",
                "request_token_url": None
            },
        }
    ]
    AUTH_ROLES_MAPPING = {
        "superset_admin": ["Admin"],
        "superset_alpha": ["Alpha"],
        "superset_gamma": ["Gamma"],
        "superset_sql_lab": ["sql_lab"]
    }
    AUTH_TYPE = AUTH_OAUTH
    AUTH_USER_REGISTRATION = True
    AUTH_USER_REGISTRATION_ROLE = 'Gamma'
    AUTH_ROLES_SYNC_AT_LOGIN = True

    # --- Issue #628 PoC: export a chat cohort into an isolated Superset dataset ---
    # Gamma's schema_access grant (#687) covers only delta.default, so any
    # dataset tagged with a different `schema` value (nominal — no real Trino
    # schema is created; the dataset's own `sql` is fully qualified) falls
    # through Superset's `raise_for_access` schema check into a genuine
    # per-object check. `chat_cohort_grants` is a narrow allowlist of
    # (dataset_id, username) consulted only when the normal check fails, so
    # cohort datasets stay private to the user who exported them.
    #
    # PoC only: CHAT_COHORT_EXPORT_TOKEN is a hardcoded shared secret that
    # authenticates report-viewer's calls to the one new
    # /internal/chat-cohort-export endpoint it guards — nothing else accepts
    # it. Replace with a provisioned Secret before this leaves prototype
    # status (see report-viewer's matching constant).
    CHAT_COHORT_EXPORT_TOKEN = "scout-poc-chat-cohort-export-8f2e1c"
    # A separate Database row (see _register_chat_cohort_export_api),
    # pointed at the same Trino connection as "Scout Data Lake" but under
    # its own name so its schema_perm isn't covered by Gamma's blanket
    # schema_access grant on [Scout Data Lake].[delta].[default].
    CHAT_EXPORT_DATABASE_NAME = "Scout Chat Exports"
    # The standard "Scout" dashboard (helm/scout-dashboards/files/analytics/
    # dashboards/core/Scout_1.yaml), cloned against cohort-scoped datasets
    # instead of leaving the user with a bare Explore view.
    CORE_DASHBOARD_UUID = "47457783-1886-46d8-9012-df03fcb684eb"
    # Every source dataset the dashboard's charts are bound to, mapped to
    # the real (delta.default) table its cohort-scoped clone widens
    # against. Not single-dataset: the "Diagnoses" chart reads reports_dx
    # (a pre-exploded one-row-per-diagnosis view), not reports_latest like
    # the other 10 charts. Extend this if a future dashboard version adds
    # another source.
    CORE_MAIN_DATASET_UUID = "14cdaed5-905e-499a-b020-13e1b54097c8"  # reports_latest.yaml
    CORE_SOURCE_DATASETS = {
        CORE_MAIN_DATASET_UUID: "reports_latest",
        "32d5849e-ae01-4933-a81c-7697cc254092": "reports_dx",  # reports_dx.yaml
        "a7e9c2b4-5f3d-4a6e-9b1c-8d7f2e4a6c9b": "reports",  # reports.yaml (curated table)
    }

    def _ensure_chat_cohort_grants_table(engine) -> None:
        from sqlalchemy import text
        with engine.begin() as conn:
            conn.execute(
                text(
                    "CREATE TABLE IF NOT EXISTS chat_cohort_grants ("
                    "dataset_id INTEGER NOT NULL, "
                    "username VARCHAR(255) NOT NULL, "
                    "created_at TIMESTAMP NOT NULL DEFAULT now(), "
                    "PRIMARY KEY (dataset_id, username))"
                )
            )

    def _clone_remap_position(position, chart_id_map) -> dict:
        for value in position.values():
            if not isinstance(value, dict) or value.get("type") != "CHART":
                continue
            meta = value.get("meta", {})
            old_id = meta.get("chartId")
            if old_id in chart_id_map:
                meta["chartId"] = chart_id_map[old_id]
        return position

    def _clone_remap_metadata(metadata, chart_id_map, dataset_id_map) -> dict:
        def remap_list(ids):
            return [chart_id_map.get(i, i) for i in ids]

        cc = metadata.get("chart_configuration") or {}
        new_cc = {}
        for key, val in cc.items():
            try:
                old_id = int(key)
            except (TypeError, ValueError):
                new_cc[key] = val
                continue
            new_id = chart_id_map.get(old_id, old_id)
            if isinstance(val, dict):
                if isinstance(val.get("id"), int):
                    val["id"] = chart_id_map.get(val["id"], val["id"])
                cf = val.get("crossFilters") or {}
                if isinstance(cf.get("chartsInScope"), list):
                    cf["chartsInScope"] = remap_list(cf["chartsInScope"])
            new_cc[str(new_id)] = val
        if cc:
            metadata["chart_configuration"] = new_cc

        gcc = metadata.get("global_chart_configuration") or {}
        if isinstance(gcc.get("chartsInScope"), list):
            gcc["chartsInScope"] = remap_list(gcc["chartsInScope"])

        for nf in metadata.get("native_filter_configuration") or []:
            if isinstance(nf.get("chartsInScope"), list):
                nf["chartsInScope"] = remap_list(nf["chartsInScope"])
            for target in nf.get("targets") or []:
                if isinstance(target, dict) and target.get("datasetId") in dataset_id_map:
                    target["datasetId"] = dataset_id_map[target["datasetId"]]
        return metadata

    def _register_chat_cohort_export_api(app) -> None:
        from flask import Blueprint
        from superset import db

        with app.app_context():
            _ensure_chat_cohort_grants_table(db.engine)

        bp = Blueprint("chat_cohort_export", __name__)

        # Flask-WTF's CSRFProtect guards every POST/PUT/PATCH/DELETE route by
        # default, including new blueprints. This endpoint is authenticated
        # by CHAT_COHORT_EXPORT_TOKEN instead of a session CSRF token, so it
        # needs an explicit exemption or every call 400s before the handler
        # runs.
        from superset.extensions import csrf

        csrf.exempt(bp)

        @bp.route("/internal/chat-cohort-export", methods=["POST"])
        def create_chat_cohort_export():
            # Imported lazily, per-request rather than at registration time
            # (which runs during KeycloakSecurityManager.__init__, mid
            # configure_fab): superset.connectors.sqla.models pulls in
            # superset.db_engine_specs, whose module-level marshmallow
            # schemas call flask_babel.gettext() at import time, and Babel
            # isn't registered in app.extensions yet at that point
            # (KeyError: 'babel' crashing every worker on boot).
            import json

            from flask_appbuilder.security.sqla.models import User as FabUser
            from sqlalchemy import text
            from superset.connectors.sqla.models import SqlaTable, SqlMetric
            from superset.models.core import Database
            from superset.models.dashboard import Dashboard
            from superset.models.slice import Slice

            token = request.headers.get("X-Cohort-Export-Token", "")
            if not hmac.compare_digest(token, CHAT_COHORT_EXPORT_TOKEN):
                return jsonify({"error": "unauthorized"}), 401
            body = request.get_json(force=True, silent=True) or {}
            sql = body.get("sql")
            username = body.get("username")
            title = body.get("title") or "Chat cohort export"
            if not sql or not username:
                return jsonify({"error": "sql and username are required"}), 400

            # Required, not just cosmetic ownership: fetch_metadata() below
            # runs impersonated as this user (override_user) so cohort SQL
            # that legitimately touches OPA-restricted tables (e.g. a
            # bypass_hidden_tables-flagged user's own patient-mapping query)
            # is authorized the same way it already was when they ran it
            # through report-viewer's own impersonated Trino connection.
            owner = db.session.query(FabUser).filter_by(username=username).first()
            if owner is None:
                return (
                    jsonify({"error": f"no Superset user found for {username!r}"}),
                    400,
                )

            source_database = (
                db.session.query(Database)
                .filter_by(database_name="Scout Data Lake")
                .first()
            )
            if source_database is None:
                return jsonify({"error": "Scout Data Lake database not found"}), 500

            # A separate Database row pointed at the identical Trino
            # connection, rather than reusing "Scout Data Lake" directly.
            # Superset's schema_perm (and so Gamma's blanket schema_access
            # grant from #687) is keyed on database_name, not the physical
            # connection - a second Database row gives cohort exports their
            # own permission namespace while the dataset's schema stays the
            # real "default" (required for fetch_metadata()/query execution
            # to resolve the cohort SQL's unqualified table names at all;
            # a nonexistent nominal schema just 400s with SCHEMA_NOT_FOUND).
            database = (
                db.session.query(Database)
                .filter_by(database_name=CHAT_EXPORT_DATABASE_NAME)
                .first()
            )
            if database is None:
                database = Database(
                    database_name=CHAT_EXPORT_DATABASE_NAME,
                    extra=source_database.extra,
                    cache_timeout=source_database.cache_timeout,
                    expose_in_sqllab=False,
                    allow_run_async=source_database.allow_run_async,
                    allow_ctas=False,
                    allow_cvas=False,
                    allow_dml=False,
                    allow_file_upload=False,
                    impersonate_user=source_database.impersonate_user,
                )
                database.set_sqlalchemy_uri(source_database.sqlalchemy_uri_decrypted)
                db.session.add(database)
                db.session.flush()

            from superset.utils.core import override_user

            def _create_cohort_dataset(source_uuid: str, source_table_name: str) -> SqlaTable:
                widened_sql = (
                    f"SELECT * FROM {source_table_name} WHERE primary_report_identifier IN "
                    f"(SELECT primary_report_identifier FROM ({sql}) cohort)"
                )
                ds_table = SqlaTable(
                    table_name=f"{title} ({username}) [{source_table_name}]",
                    schema="default",
                    catalog="delta",
                    sql=widened_sql,
                    database=database,
                    owners=[owner],
                )
                db.session.add(ds_table)
                db.session.flush()  # assign ds_table.id
                # Introspects the query via Trino to populate columns and the
                # default "count" metric - the same step Superset's own
                # dataset-creation flow runs. Skipped, the cloned charts
                # below (which reference "count" by name) fail with "Metric
                # 'count' does not exist" since a bare ORM insert leaves the
                # new dataset with zero columns/metrics. Impersonated as the
                # exporting user rather than run under the unimpersonated
                # superset_svc system identity, which OPA's hidden-table
                # policy never grants bypass_hidden_tables to.
                with override_user(owner):
                    ds_table.fetch_metadata()
                # fetch_metadata() only ever synthesizes the default "count"
                # metric from the query's output columns - it doesn't know
                # about curated metrics like reports_dx's distinct_reports
                # (COUNT(DISTINCT message_control_id)). Copy any of the
                # source dataset's own metric definitions the cloned charts
                # might reference by name.
                source_dataset = (
                    db.session.query(SqlaTable).filter_by(uuid=source_uuid).first()
                )
                existing_metric_names = {m.metric_name for m in ds_table.metrics}
                for src_metric in (source_dataset.metrics if source_dataset is not None else []):
                    if src_metric.metric_name in existing_metric_names:
                        continue
                    ds_table.metrics.append(
                        SqlMetric(
                            metric_name=src_metric.metric_name,
                            verbose_name=src_metric.verbose_name,
                            metric_type=src_metric.metric_type,
                            expression=src_metric.expression,
                            description=src_metric.description,
                            d3format=src_metric.d3format,
                            currency=src_metric.currency,
                            warning_text=src_metric.warning_text,
                        )
                    )
                db.session.flush()
                db.session.execute(
                    text(
                        "INSERT INTO chat_cohort_grants (dataset_id, username) "
                        "VALUES (:did, :u) ON CONFLICT DO NOTHING"
                    ),
                    {"did": ds_table.id, "u": username},
                )
                return ds_table

            # Always create the main (reports_latest) dataset - used for the
            # bare Explore fallback below even when the dashboard isn't
            # cloned. Additional source datasets (e.g. reports_dx) are
            # created lazily, only if the dashboard clone actually needs
            # them.
            table = _create_cohort_dataset(
                CORE_MAIN_DATASET_UUID, CORE_SOURCE_DATASETS[CORE_MAIN_DATASET_UUID]
            )
            cohort_tables = {CORE_MAIN_DATASET_UUID: table}

            # Clone the standard Scout dashboard against the cohort
            # dataset(s), if it's been deployed (helm/scout-dashboards
            # import Job creates it). Skipped gracefully otherwise - the
            # bare dataset/Explore view still works.
            dashboard_url = None
            source_dashboard = (
                db.session.query(Dashboard).filter_by(uuid=CORE_DASHBOARD_UUID).first()
            )
            if source_dashboard is not None:
                # Live source dataset id -> its uuid, so each chart's
                # datasource_id can be resolved back to which cohort clone
                # (creating it on first use) it belongs on.
                source_uuid_by_id = {}
                for src_uuid in CORE_SOURCE_DATASETS:
                    src_ds = db.session.query(SqlaTable).filter_by(uuid=src_uuid).first()
                    if src_ds is not None:
                        source_uuid_by_id[src_ds.id] = src_uuid

                chart_id_map = {}
                dataset_id_map = {}
                new_slices = []
                for src_slice in source_dashboard.slices:
                    src_uuid = source_uuid_by_id.get(src_slice.datasource_id)
                    if src_uuid is None:
                        # Chart bound to a dataset CORE_SOURCE_DATASETS
                        # doesn't know about - skip cloning it rather than
                        # guess which cohort dataset it belongs on.
                        continue
                    if src_uuid not in cohort_tables:
                        cohort_tables[src_uuid] = _create_cohort_dataset(
                            src_uuid, CORE_SOURCE_DATASETS[src_uuid]
                        )
                    target_table = cohort_tables[src_uuid]
                    dataset_id_map[src_slice.datasource_id] = target_table.id

                    params = json.loads(src_slice.params or "{}")
                    params["datasource"] = f"{target_table.id}__table"
                    params.pop("dashboards", None)
                    new_slice = Slice(
                        slice_name=src_slice.slice_name,
                        viz_type=src_slice.viz_type,
                        datasource_id=target_table.id,
                        datasource_type="table",
                        params=json.dumps(params),
                        # Regenerated fresh on first render from params/datasource
                        # rather than carried over pointed at the old dataset.
                        query_context=None,
                        cache_timeout=src_slice.cache_timeout,
                    )
                    if owner is not None:
                        new_slice.owners = [owner]
                    db.session.add(new_slice)
                    db.session.flush()  # assign new_slice.id
                    chart_id_map[src_slice.id] = new_slice.id
                    new_slices.append(new_slice)

                position = _clone_remap_position(
                    json.loads(source_dashboard.position_json or "{}"), chart_id_map
                )
                metadata = _clone_remap_metadata(
                    json.loads(source_dashboard.json_metadata or "{}"),
                    chart_id_map,
                    dataset_id_map,
                )
                new_dashboard = Dashboard(
                    dashboard_title=f"{title} ({username})",
                    position_json=json.dumps(position),
                    json_metadata=json.dumps(metadata),
                    # Draft (not published): Superset restricts draft
                    # dashboards to owners + admins, giving this real
                    # dashboard-level isolation independent of the dataset's
                    # chat_cohort_grants check below.
                    published=False,
                    slices=new_slices,
                )
                if owner is not None:
                    new_dashboard.owners = [owner]
                db.session.add(new_dashboard)
                db.session.flush()  # assign new_dashboard.id
                dashboard_url = f"/superset/dashboard/{new_dashboard.id}/"

            db.session.commit()

            return (
                jsonify(
                    {
                        "dataset_id": table.id,
                        "explore_url": (
                            f"/explore/?datasource_type=table&datasource_id={table.id}"
                        ),
                        "dashboard_url": dashboard_url,
                    }
                ),
                201,
            )

        app.register_blueprint(bp)

    class KeycloakOAuthView(AuthOAuthView):
        """
        Custom Auth View to handle Keycloak login and logout redirection
        """
        @expose("/login/")
        def login(self, provider="keycloak"):
            # Hacky workaround to remove stale 'Access is Denied' error messages from session.
            # When an unauthenticated user tries to access a protected page, Superset queues an 'Access is Denied' popup message.
            # With OAuth, the user is redirected to an external login page, so the error is not shown immediately.
            # After successful login, the old error message is displayed, which is confusing since the user now has access.
            flashes = session.get('_flashes', [])
            logging.debug(f"Flashes before cleanup: {flashes}")
            session['_flashes'] = [f for f in flashes if f != ('danger', 'Access is Denied')]
            logging.debug(f"Flashes after cleanup: {session.get('_flashes', [])}")
            return super().login(provider=provider)
        @expose('/logout/', methods=['GET', 'POST'])
        def logout(self):
            super().logout()
            return redirect('{{ oauth2_proxy_signout_url }}')
    class KeycloakSecurityManager(SupersetSecurityManager):
        """
        Create a new SecurityManager that uses the KeycloakOAuthView and Keycloak role mapping
        """
        def __init__(self, appbuilder):
            super(KeycloakSecurityManager, self).__init__(appbuilder)
            app = self.appbuilder.get_app
            app.config.setdefault("AUTH_ROLES_MAPPING", AUTH_ROLES_MAPPING)
            app.config.setdefault("AUTH_TYPE", AUTH_OAUTH)
            self.authoauthview = KeycloakOAuthView
            _register_chat_cohort_export_api(app)
        def raise_for_access(self, **kwargs) -> None:
            # The base check only confirms the caller can use the (shared) Trino
            # database, not that they ran the query, so any signed-in user could
            # download another user's SQL Lab results via its guessable id.
            # Require query ownership unless the caller has all_query_access.
            try:
                super().raise_for_access(**kwargs)
            except SupersetSecurityException:
                # Issue #628 PoC: a chat-cohort-export dataset the base check
                # rejects (no schema_access, not owner) is still allowed if
                # the caller holds an explicit chat_cohort_grants row for it.
                if self._has_chat_cohort_export_grant(kwargs.get("datasource")):
                    return
                raise
            query = kwargs.get("query")
            if (
                query is not None
                and not self.can_access("all_query_access", "all_query_access")
                and query.user_id != g.user.id
            ):
                raise SupersetSecurityException(
                    SupersetError(
                        error_type=SupersetErrorType.QUERY_SECURITY_ACCESS_ERROR,
                        message="You do not have access to this query.",
                        level=ErrorLevel.ERROR,
                    )
                )
        def _has_chat_cohort_export_grant(self, datasource) -> bool:
            from sqlalchemy import text
            from superset import db
            database = getattr(datasource, "database", None)
            if (
                datasource is None
                or getattr(database, "database_name", None) != CHAT_EXPORT_DATABASE_NAME
                or not g.user
                or g.user.is_anonymous
            ):
                return False
            row = db.session.execute(
                text(
                    "SELECT 1 FROM chat_cohort_grants "
                    "WHERE dataset_id = :did AND username = :u"
                ),
                {"did": datasource.id, "u": g.user.username},
            ).first()
            return row is not None
    CUSTOM_SECURITY_MANAGER = KeycloakSecurityManager
  proxy_configuration: |
    PREFERRED_URL_SCHEME = "https"
    ENABLE_PROXY_FIX = True
  feature_flags: |
    # Key cached chart/dashboard results by user so a broad-access user's
    # cached copy is never served to a narrower-access viewer (refs #502).
    FEATURE_FLAGS = {
        "CACHE_QUERY_BY_USER": True,
    }
  prometheus_metrics: |
{{ lookup('file', role_path + '/files/superset_metrics.py') | indent(4, first=True) }}
  trino_auth: |
{{ lookup('file', role_path + '/files/superset_trino_auth.py') | indent(4, first=True) }}
  statsd_logging: |
    from superset.stats_logger import StatsdStatsLogger
    STATS_LOGGER = StatsdStatsLogger(
        host='localhost',
        port={{ superset_statsd_port }},
        prefix='{{ superset_statsd_prefix }}'
    )
extraVolumes:
  - name: scout-logo
    configMap:
      name: scout-logo
      defaultMode: 0644
  - name: statsd-mapping
    configMap:
      name: superset-statsd-mapping
  # CA cert from the same Secret cert-manager populates for Trino's TLS
  # listener. DB_CONNECTION_MUTATOR passes /etc/trino-ca/ca.crt as the
  # http_session.verify so Trino's self-signed cert is trusted.
  - name: trino-ca
    secret:
      secretName: trino-tls
      items:
        - key: ca.crt
          path: ca.crt
extraVolumeMounts:
  - name: scout-logo
    mountPath: /app/superset/static/assets/images/scout.png
    subPath: scout.png
    readOnly: true
  - name: scout-logo
    mountPath: /app/superset/static/assets/images/favicon.ico
    subPath: favicon.ico
    readOnly: true
  - name: trino-ca
    mountPath: /etc/trino-ca
    readOnly: true
init:
  # Override the apache/superset chart's default firstname/lastname so the
  # local admin user shows as "Scout Admin" in the Superset UI. Only takes
  # effect on first install (the init job creates the admin row if absent).
  adminUser:
    firstname: Scout
    lastname: Admin
    email: admin@scout.local
  initscript: |
    {{ lookup('template', 'init_script.sh.j2') | indent(4) }}
