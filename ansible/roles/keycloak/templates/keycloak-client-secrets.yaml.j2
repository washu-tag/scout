{#- The credentials the realm document no longer carries.

    The realm names each one as `$(env:<key>)`; keycloak-config-cli
    resolves those from its own process environment, and this Secret is what
    reaches that environment through `envFrom`. So the keys below are not free
    choices -- each one is the token spelled out in the realm document, and the
    two lanes share them (deploy/required-secrets.md lists the same set).

    Values are base64 for `data:` rather than `stringData:`, so re-running the
    role with unchanged secrets leaves the Secret's resourceVersion alone. The
    app manager watches that resourceVersion to decide a rotation happened.

    Conditional keys track the realm document's own conditionals exactly: a key
    the document does not reference is merely unused, but a key it references
    and this file omits becomes the literal string `$(env:...)` installed as a
    client's credential. -#}
oauth2_proxy: {{ keycloak_oauth2_proxy_client_secret | b64encode | to_json }}
jupyterhub: {{ keycloak_jupyterhub_client_secret | b64encode | to_json }}
grafana: {{ keycloak_grafana_client_secret | b64encode | to_json }}
temporal: {{ keycloak_temporal_client_secret | b64encode | to_json }}
superset: {{ keycloak_superset_client_secret | b64encode | to_json }}
minio: {{ keycloak_minio_client_secret | b64encode | to_json }}
launchpad_client: {{ keycloak_launchpad_client_secret | b64encode | to_json }}
open_webui: {{ keycloak_open_webui_client_secret | b64encode | to_json }}
superset_svc: {{ keycloak_superset_svc_client_secret | b64encode | to_json }}
voila_svc: {{ keycloak_voila_svc_client_secret | b64encode | to_json }}
report_viewer_svc: {{ keycloak_report_viewer_svc_client_secret | b64encode | to_json }}
{% if enable_xnat | default(false) | bool %}
xnat: {{ keycloak_xnat_client_secret | b64encode | to_json }}
{% endif %}
{% if keycloak_gh_client_id is defined and keycloak_gh_client_id %}
github_client_id: {{ keycloak_gh_client_id | b64encode | to_json }}
github_client_secret: {{ keycloak_gh_client_secret | b64encode | to_json }}
{% endif %}
{% if keycloak_microsoft_client_id is defined and keycloak_microsoft_client_id %}
microsoft_client_id: {{ keycloak_microsoft_client_id | b64encode | to_json }}
microsoft_client_secret: {{ keycloak_microsoft_client_secret | b64encode | to_json }}
microsoft_tenant_id: {{ keycloak_microsoft_tenant_id | b64encode | to_json }}
{% endif %}
