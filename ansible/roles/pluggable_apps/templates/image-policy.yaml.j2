apiVersion: admissionregistration.k8s.io/v1
kind: MutatingAdmissionPolicy
metadata:
  name: pluggable-app-{{ pluggable_app.name }}
spec:
  failurePolicy: Fail
  reinvocationPolicy: Never
  matchConstraints:
    resourceRules:
      - apiGroups: ['']
        apiVersions: [v1]
        operations: [CREATE]
        resources: [pods]
{% if air_gapped | default(false) | bool %}
  variables:
    - name: routes
      expression: {{ _pluggable_app_logins | pluggable_app_image_routes(_pluggable_apps_harbor_hostname) | to_json | to_json }}
    - name: initContainers
      expression: 'has(object.spec.initContainers) ? object.spec.initContainers : []'
  mutations:
    - patchType: ApplyConfiguration
      applyConfiguration:
        expression: >-
          Object{
            spec: Object.spec{
              containers: object.spec.containers
                .filter(c, variables.routes.exists(p, c.image.startsWith(p)))
                .map(c, Object.spec.containers{
                  name: c.name,
                  image: variables.routes.filter(p, c.image.startsWith(p))
                    .map(p, variables.routes[p] + c.image.substring(size(p)))[0]
                }),
              initContainers: variables.initContainers
                .filter(c, variables.routes.exists(p, c.image.startsWith(p)))
                .map(c, Object.spec.initContainers{
                  name: c.name,
                  image: variables.routes.filter(p, c.image.startsWith(p))
                    .map(p, variables.routes[p] + c.image.substring(size(p)))[0]
                })
            }
          }
{% else %}
  matchConditions:
    - name: lacks-pull-secret
      expression: >-
        !has(object.spec.imagePullSecrets) ||
        !object.spec.imagePullSecrets.exists(s, s.name == '{{ pluggable_app.name }}-registry')
  mutations:
    - patchType: JSONPatch
      jsonPatch:
        expression: >-
          has(object.spec.imagePullSecrets)
            ? [JSONPatch{op: 'add', path: '/spec/imagePullSecrets/-',
                         value: Object.spec.imagePullSecrets{name: '{{ pluggable_app.name }}-registry'}}]
            : [JSONPatch{op: 'add', path: '/spec/imagePullSecrets',
                         value: [Object.spec.imagePullSecrets{name: '{{ pluggable_app.name }}-registry'}]}]
{% endif %}
---
apiVersion: admissionregistration.k8s.io/v1
kind: MutatingAdmissionPolicyBinding
metadata:
  name: pluggable-app-{{ pluggable_app.name }}
spec:
  policyName: pluggable-app-{{ pluggable_app.name }}
  matchResources:
    namespaceSelector:
      matchLabels:
        kubernetes.io/metadata.name: {{ pluggable_app.namespace }}
