{# Helm values for the upstream xnatworks/xnat-web chart, templated from inventory.
   All Secrets are created by the role and referenced here by name. Dynamic
   blocks (initContainers / plugins / authplugins / extraConfig / extraVolumes)
   are generated from xnat_plugins_all. #}
replicaCount: 1

{# Container-service on a Kubernetes backend: provisions the CS RBAC + SA token.
   The DockerServer (backend=kubernetes) is registered post-deploy by the role's
   tasks/configure_cs.yaml. #}
containerService: {{ xnat_container_service | bool | string | lower }}
{# The chart binds the CS ServiceAccount (a ClusterRoleBinding) and references PVs
   by this namespace; its default is empty, which renders an invalid binding
   (subjects[0].namespace required). Set it to the release namespace, per the IaC lane. #}
namespace: {{ xnat_namespace }}

image:
  repository: {{ xnat_image_repository }}
  tag: '{{ xnat_image_tag }}'

# WORKAROUND (NrgXnat/xnat#5): PR NrgXnat/helm-charts#19 hardened the container
# securityContext with `capabilities: drop: [ALL]`, which removes CAP_DAC_OVERRIDE.
# The xnatworks/xnat-web image needs it: it runs as a non-root UID (1000 = the
# image's `tomcat` user) that does not own its entrypoint
# (/usr/local/bin/entrypoint.sh, mode 0744 root:root), so DAC_OVERRIDE is what
# lets it exec the entrypoint. With all caps dropped the container can't start
# ("exec /usr/local/bin/entrypoint.sh: permission denied"). Keep the chart's
# drop-ALL hardening but add back only DAC_OVERRIDE; runAsUser 1000 itself is
# fine (tomcat owns the data dirs). Once NrgXnat/xnat#5 is fixed (image works
# with caps dropped), drop this block.
securityContext:
  capabilities:
    drop: ['ALL']
    add: ['DAC_OVERRIDE']

# The Scout plugin-installer init containers run as non-root UID 1000 (see their
# per-container securityContext below). fsGroup makes the shared home-plugins
# emptyDir group-owned by 1000 so a non-root installer can write the JARs into
# it; without it, emptyDir writability for non-root is runtime-dependent. UID
# 1000 matches the xnat-web tomcat user, so the main container reads them fine.
# OnRootMismatch skips the recursive volume chown when ownership already matches
# (avoids re-chowning the data PVCs on every pod restart).
podSecurityContext:
  fsGroup: 1000
  fsGroupChangePolicy: OnRootMismatch

# Single-node dev posture; revisit before HA.
redis:
  enabled: false
activemq:
  broker:
    enabled: false
# XNAT routes outbound mail through Scout's shared relay (see [notifications] in
# prefs-init.ini), so the chart's bundled Postfix subchart stays off.
mail:
  enabled: false

# CNPG-managed Postgres, matching the rest of Scout.
cnpg:
  cluster:
    enabled: true
    instances: 1
    storage:
      size: {{ xnat_postgres_storage_size }}
{% if xnat_storage_class %}
      storageClass: {{ xnat_storage_class }}
{% endif %}
    credentials:
      database: {{ xnat_postgres_db }}
      username: {{ xnat_postgres_user }}
      # to_json keeps an operator-chosen password a string (YAML 1.1 would
      # coerce e.g. 'no'/'0x1A') and escapes any syntax characters.
      password: {{ xnat_postgres_password | to_json }}

ingress:
  enabled: true
  annotations:
    kubernetes.io/ingress.class: traefik
    # oauth2-proxy ForwardAuth (edge approval gate) + error redirect + the
    # same-origin security-headers variant. The openid plugin's /openid-login is
    # an app-level callback behind this middleware, not an open path.
    # NB: XNAT's own UI frames same-origin pages, so it uses the -sameorigin
    # headers (frame-ancestors 'self') rather than the global 'none'/DENY, which
    # would trip "violates frame-ancestors 'none'" in the browser.
    traefik.ingress.kubernetes.io/router.middlewares: >-
      kube-system-oauth2-proxy-error@kubernetescrd,
      kube-system-oauth2-proxy-auth@kubernetescrd,
      kube-system-security-headers-sameorigin@kubernetescrd
  hosts:
    - host: xnat.{{ server_hostname }}
      paths:
        - path: /
          pathType: Prefix

volumes:
{% for vol, size in xnat_volume_sizes.items() %}
  {{ vol }}:
    accessMode: ReadWriteOnce
    size: {{ size }}
{% if xnat_storage_class %}
    storageClass: {{ xnat_storage_class }}
{% endif %}
{% endfor %}

# Bump the startup probe so Hibernate's first-boot DDL (3-5 min) completes
# before the pod is killed. Pairs with the helm --wait timeout.
probes:
  startup:
    failureThreshold: {{ xnat_startup_failure_threshold }}

# Role-managed Secrets are referenced by name only, and every mount uses
# subPath (never refreshed by kubelet), so hash their rendered content into the
# pod template: a Secret change (e.g. rotating keycloak_xnat_client_secret)
# then rolls the pod on the same helm upgrade. Computed in create_secrets.yaml.
podAnnotations:
  checksum/scout-secrets: '{{ _xnat_secrets_checksum }}'

{# --- Auth-provider plugins: the chart mounts Secret xnat-plugin-<entry>
     (key <provider>-provider-properties) at config/auth/<provider>-provider.properties --#}
{% set authplugin_entries = [] %}
{% for p in xnat_plugins_all %}{% for c in p.config | default([]) if c.mechanism == 'authplugins' %}{% set _ = authplugin_entries.append(c) %}{% endfor %}{% endfor %}
{% if authplugin_entries %}
authplugins:
{% for c in authplugin_entries %}
  {{ c.entry }}:
    provider: {{ c.provider }}
    auth: true
{% endfor %}
{% else %}
authplugins: {}
{% endif %}

{# --- Image-based plugins use the chart's native plugins: map (Pattern C) --#}
{% set image_plugins = xnat_plugins_all | selectattr('source.type', 'equalto', 'image') | list %}
{% if image_plugins %}
plugins:
{% for p in image_plugins %}
  {{ p.name }}:
    repository: {{ p.source.repository }}
    tag: '{{ p.source.tag }}'
{% endfor %}
{% endif %}

{# --- extraConfig: merged from all extraConfig blocks + base xnat_extra_config --#}
{% set extra = {} %}
{% for k, v in (xnat_extra_config | default({})).items() %}{% set _ = extra.update({k: v}) %}{% endfor %}
{% for p in xnat_plugins_all %}
{% for c in p.config | default([]) %}
{% if c.mechanism == 'extraConfig' %}
{% for k, v in c.properties.items() %}{% set _ = extra.update({k: v}) %}{% endfor %}
{% endif %}
{% endfor %}
{% endfor %}
{% if extra %}
extraConfig:
{% for k, v in extra.items() %}
  {{ k | string | to_json }}: {{ v | string | to_json }}
{% endfor %}
{% endif %}

{# --- extraVolumes: prefs-init + jar Secrets + file-config Secrets --#}
extraVolumes:
  - name: prefs-init
    secret:
      secretName: xnat-prefs-init
{% for p in xnat_plugins_all if p.source.type == 'file' %}
  - name: plugin-{{ p.name }}-jar
    secret:
      secretName: xnat-plugin-{{ p.name }}-jar
{% endfor %}
{% for p in xnat_plugins_all %}
{% for c in p.config | default([]) if c.mechanism == 'file' %}
  - name: cfg-{{ p.name }}-{{ loop.index }}
    secret:
      # `| lower` matches the Secret name built in tasks/create_secrets.yaml
      # (k8s Secret names must be lowercase RFC 1123) — keep them in sync.
      secretName: xnat-plugin-{{ p.name }}-cfg-{{ c.dest | basename | regex_replace('[^A-Za-z0-9]', '-') | lower }}
{% endfor %}
{% endfor %}
{% if _xnat_maven_settings_needed | default(false) | bool %}
  - name: maven-settings
    configMap:
      name: xnat-maven-settings
{% endif %}
{% if _xnat_needs_staging_cert | default(false) | bool %}
  - name: staging-ca
    secret:
      secretName: staging-ca-cert
{% endif %}
{% if xnat_dev_war | length %}
  - name: webapps
    emptyDir: {}
{% endif %}

extraVolumeMounts:
  - name: prefs-init
    mountPath: /data/xnat/home/config/prefs-init.ini
    subPath: prefs-init.ini
{% for p in xnat_plugins_all %}
{% for c in p.config | default([]) if c.mechanism == 'file' %}
  - name: cfg-{{ p.name }}-{{ loop.index }}
    mountPath: /data/xnat/home/{{ c.dest }}
    subPath: {{ c.dest | basename }}
    readOnly: true
{% endfor %}
{% endfor %}
{% if xnat_dev_war | length %}
  - name: webapps
    mountPath: /usr/local/tomcat/webapps
{% endif %}

{# --- initContainers: one per non-image plugin, running the Scout installer.
     Spliced by the chart after wait-for-postgres, before home-init. Each mounts
     the shared home-plugins volume (NOT auto-mounted for user init containers). --#}
initContainers:
{% for p in xnat_plugins_all if p.source.type in ['file', 'url', 'coordinates'] %}
  - name: install-{{ p.name }}
    image: {{ xnat_plugin_installer_image }}
    imagePullPolicy: {{ xnat_plugin_installer_image_pull_policy }}
    # Non-root (UID 1000, matching the xnat-web tomcat user). The installer needs
    # no capabilities: its entrypoint is world-executable and all writes go to a
    # /tmp workdir + the fsGroup-shared plugins volume (see podSecurityContext).
    securityContext:
      runAsNonRoot: true
      runAsUser: 1000
      allowPrivilegeEscalation: false
      capabilities:
        drop: ['ALL']
      seccompProfile:
        type: RuntimeDefault
    env:
      - name: PLUGIN_NAME
        value: '{{ p.name }}'
      - name: PLUGIN_TARGET
        value: '{{ p.target }}'
      - name: PLUGIN_SOURCE_TYPE
        value: '{{ p.source.type }}'
      - name: DEST_DIR
        value: /data/xnat/home/plugins
      - name: PLUGIN_SKIP_LOGBACK_REWRITE
        value: '{{ p.skip_logback_rewrite | default(false) | string | lower }}'
{% if p.source.type == 'coordinates' %}
      - name: PLUGIN_COORDINATES
        value: '{{ p.source.coordinates }}'
{% if _xnat_needs_staging_cert | default(false) | bool %}
      - name: PLUGIN_CA_CERT
        value: '{{ _xnat_staging_ca_path }}'
{% endif %}
{% elif p.source.type == 'url' %}
      - name: PLUGIN_URL
        value: '{{ p.source.url }}'
{% elif p.source.type == 'file' %}
      - name: PLUGIN_FILE
        value: "/mnt/{{ p.name }}/{{ p.source.secret.key | default('plugin.jar') }}"
{% endif %}
    volumeMounts:
      - name: home-plugins
        mountPath: /data/xnat/home/plugins
{% if p.source.type == 'file' %}
      - name: plugin-{{ p.name }}-jar
        mountPath: /mnt/{{ p.name }}
        readOnly: true
{% endif %}
{% if p.source.type == 'coordinates' and (_xnat_maven_settings_needed | default(false) | bool) %}
      - name: maven-settings
        mountPath: /mnt/maven
        readOnly: true
{% endif %}
{% if p.source.type == 'coordinates' and (_xnat_needs_staging_cert | default(false) | bool) %}
      - name: staging-ca
        mountPath: /mnt/staging-ca
        readOnly: true
{% endif %}
{% endfor %}
{# --- developWar side-load (dev/test): pull an unreleased WAR / plugins from
     MinIO, staged by tasks/dev_stage.yaml. mc reads creds from the
     xnat-dev-minio Secret ($S3_USER/$S3_PASS) and writes its config under /tmp.
     Gated on xnat_dev_war / xnat_dev_plugins. --#}
{% if xnat_dev_war | length %}
  - name: develop-war
    image: {{ minio_client_image }}:{{ minio_client_image_tag }}
    imagePullPolicy: IfNotPresent
    command: ['/bin/sh', '-c']
    args:
      - 'mc alias set scout {{ s3_endpoint }} "$S3_USER" "$S3_PASS" && mc cp scout/{{ xnat_dev_bucket }}/ROOT.war /webapps/ROOT.war'
    env:
      - name: HOME
        value: /tmp
    envFrom:
      - secretRef:
          name: xnat-dev-minio
    securityContext:
      runAsNonRoot: true
      runAsUser: 1000
      allowPrivilegeEscalation: false
      capabilities:
        drop: ['ALL']
      seccompProfile:
        type: RuntimeDefault
    volumeMounts:
      - name: webapps
        mountPath: /webapps
{% endif %}
{% if xnat_dev_plugins | length %}
  - name: develop-plugins
    image: {{ minio_client_image }}:{{ minio_client_image_tag }}
    imagePullPolicy: IfNotPresent
    command: ['/bin/sh', '-c']
    args:
      - 'mc alias set scout {{ s3_endpoint }} "$S3_USER" "$S3_PASS" && mc mirror --overwrite scout/{{ xnat_dev_bucket }}/plugins/ /data/xnat/home/plugins/'
    env:
      - name: HOME
        value: /tmp
    envFrom:
      - secretRef:
          name: xnat-dev-minio
    securityContext:
      runAsNonRoot: true
      runAsUser: 1000
      allowPrivilegeEscalation: false
      capabilities:
        drop: ['ALL']
      seccompProfile:
        type: RuntimeDefault
    volumeMounts:
      - name: home-plugins
        mountPath: /data/xnat/home/plugins
{% endif %}
