{# Helm values for the upstream NrgXnat xnat chart, templated from inventory.
   All Secrets are created by the role and referenced here by name. Dynamic
   blocks (initContainers / plugins / authplugins / extraConfig / extraVolumes)
   are generated from xnat_plugins_all. #}
replicaCount: {{ xnat_replica_count | int }}

{# Container-service on a Kubernetes backend: provisions the CS RBAC + SA token.
   The DockerServer (backend=kubernetes) is registered post-deploy by the role's
   tasks/configure_cs.yaml. #}
containerService: {{ xnat_container_service | bool | string | lower }}
{# The chart binds the CS ServiceAccount (a ClusterRoleBinding) and references PVs
   by this namespace; its default is empty, which renders an invalid binding
   (subjects[0].namespace required). Set it to the release namespace, per the IaC lane. #}
namespace: {{ xnat_namespace }}

image:
  repository: {{ xnat_image_repository }}
  tag: '{{ xnat_image_tag }}'

# The Scout plugin-installer init containers run as non-root UID 1000 (see their
# per-container securityContext below). fsGroup makes the shared home-plugins
# emptyDir group-owned by 1000 so a non-root installer can write the JARs into
# it; without it, emptyDir writability for non-root is runtime-dependent. UID
# 1000 matches the xnat-web tomcat user, so the main container reads them fine.
# OnRootMismatch skips the recursive volume chown when ownership already matches
# (avoids re-chowning the data PVCs on every pod restart).
podSecurityContext:
  fsGroup: 1000
  fsGroupChangePolicy: OnRootMismatch

# Single-node dev posture; revisit before HA.
redis:
  enabled: false
activemq:
  broker:
    enabled: false
# XNAT routes outbound mail through Scout's shared relay (see [notifications] in
# prefs-init.ini), so the chart's bundled Postfix subchart stays off.
mail:
  enabled: false

# CNPG-managed Postgres, matching the rest of Scout.
cnpg:
  cluster:
    enabled: true
    instances: 1
    storage:
      size: {{ xnat_postgres_storage_size }}
{% if xnat_storage_class %}
      storageClass: {{ xnat_storage_class }}
{% endif %}
    credentials:
      database: {{ xnat_postgres_db }}
      username: {{ xnat_postgres_user }}
      # to_json keeps an operator-chosen password a string (YAML 1.1 would
      # coerce e.g. 'no'/'0x1A') and escapes any syntax characters.
      password: {{ xnat_postgres_password | to_json }}

ingress:
  enabled: true
  annotations:
    kubernetes.io/ingress.class: traefik
    # oauth2-proxy ForwardAuth (edge approval gate) + error redirect + the
    # same-origin security-headers variant. The openid plugin's /openid-login is
    # an app-level callback behind this middleware, not an open path.
    # NB: XNAT's own UI frames same-origin pages, so it uses the -sameorigin
    # headers (frame-ancestors 'self') rather than the global 'none'/DENY, which
    # would trip "violates frame-ancestors 'none'" in the browser.
    traefik.ingress.kubernetes.io/router.middlewares: >-
      kube-system-oauth2-proxy-error@kubernetescrd,
      kube-system-oauth2-proxy-auth@kubernetescrd,
      kube-system-security-headers-sameorigin@kubernetescrd
  hosts:
    - host: xnat.{{ server_hostname }}
      paths:
        - path: /
          pathType: Prefix

volumes:
{% for vol, size in xnat_volume_sizes.items() %}
  {{ vol }}:
    accessMode: ReadWriteOnce
    size: {{ size }}
{% if xnat_storage_class %}
    storageClass: {{ xnat_storage_class }}
{% endif %}
{% endfor %}

# Bump the startup probe so Hibernate's first-boot DDL (3-5 min) completes
# before the pod is killed. Pairs with the helm --wait timeout.
probes:
  startup:
    failureThreshold: {{ xnat_startup_failure_threshold }}

# Role-managed Secrets are referenced by name only, and every mount uses
# subPath (never refreshed by kubelet), so hash their rendered content into the
# pod template: a Secret change (e.g. rotating keycloak_xnat_client_secret)
# then rolls the pod on the same helm upgrade. Computed in create_secrets.yaml.
podAnnotations:
  checksum/scout-secrets: '{{ _xnat_secrets_checksum }}'
{% if _xnat_dev_artifacts_checksum | default('') %}
  # Re-staging xnat_dev_war / xnat_dev_plugins changes this hash, so the helm
  # upgrade rolls the StatefulSet and the home-plugins emptyDir re-syncs the new
  # artifacts (fingerprint computed in tasks/dev_stage.yaml).
  checksum/dev-artifacts: '{{ _xnat_dev_artifacts_checksum }}'
{% endif %}

{# --- Auth-provider plugins: the chart mounts Secret xnat-plugin-<entry>
     (key <provider>-provider-properties) at config/auth/<provider>-provider.properties --#}
{% set authplugin_entries = [] %}
{% for p in xnat_plugins_all %}{% for c in p.config | default([]) if c.mechanism == 'authplugins' %}{% set _ = authplugin_entries.append(c) %}{% endfor %}{% endfor %}
{% if authplugin_entries %}
authplugins:
{% for c in authplugin_entries %}
  {{ c.entry }}:
    provider: {{ c.provider }}
    auth: true
{% endfor %}
{% else %}
authplugins: {}
{% endif %}

{# --- Plugins: every source form goes through the chart's native plugins: map.
     The chart renders one init container per entry and resolves coordinate/url
     artifacts to a final URL at template time, so nothing here hand-rolls an
     init container or mounts a Maven settings.xml. --#}
{# Config-only entries (source.type: none, e.g. the openid SSO config) contribute
   only an authplugins entry + a provider-properties Secret (rendered above and in
   create_secrets) — they must NOT become chart plugins: entries. The chart has no
   'none' source, so it would treat one as a fetch and fail. #}
{% set _installable = xnat_plugins_all | rejectattr('source.type', 'equalto', 'none') | list %}
{% if _installable %}
plugins:
{% for p in _installable %}
  {{ p.name }}:
{% if p.source.type == 'image' %}
    repository: {{ p.source.repository }}
    tag: '{{ p.source.tag }}'
{% else %}
    source: {{ p.source.type }}
    target: {{ p.target }}
{% if p.source.type == 'coordinates' %}
    coordinates: '{{ p.source.coordinates }}'
    # Air-gapped: resolve through the Nexus group; otherwise the plugin's own
    # repo_url (or Maven Central). Set per plugin so plugins in different repos work.
    mavenUrl: '{{ maven_proxy_url if (air_gapped | bool) else (p.source.repo_url | default("https://repo1.maven.org/maven2/", true)) }}'
{% elif p.source.type == 'url' %}
    url: '{{ p.source.url }}'
{% elif p.source.type == 'file' %}
    {#- The jar rides in a Secret created by tasks/create_secrets.yaml; the chart
        mounts it, so no extraVolumes entry is needed for it. #}
    secret:
      name: xnat-plugin-{{ p.name }}-jar
      key: {{ p.source.secret.key | default('plugin.jar') }}
{% endif %}
{% if p.source.sha256 | default('') %}
    sha256: '{{ p.source.sha256 }}'
{% endif %}
{% endif %}
{% endfor %}
{% endif %}

{# --- Installer container. A stock curl image the chart defaults; Scout only
     supplies the hardened securityContext and, air-gapped, the CA the
     self-signed Nexus is served with (ADR-0016). --#}
pluginInstaller:
  securityContext:
    runAsNonRoot: true
    runAsUser: 1000
    allowPrivilegeEscalation: false
    capabilities:
      drop: ['ALL']
    seccompProfile:
      type: RuntimeDefault
{% if _xnat_needs_staging_cert | default(false) | bool %}
  caCertSecret: staging-ca-cert
{% endif %}
{# --- Dev/test side-load (xnat_dev_war / xnat_dev_plugins): the chart pulls both
     from the staging bucket, so there are no hand-rolled init containers left.
     Artifacts are staged to MinIO by tasks/dev_stage.yaml; the chart's S3 support
     reaches it via endpointUrl + the xnat-dev-minio Secret, whose keys are
     S3_USER / S3_PASS rather than the AWS names. --#}
{% if (xnat_dev_war | length) or (xnat_dev_plugins | length) %}
  s3:
    image: '{{ xnat_dev_awscli_image }}'
    endpointUrl: '{{ s3_endpoint }}'
    existingSecret: xnat-dev-minio
    secretKeys:
      accessKeyId: S3_USER
      secretAccessKey: S3_PASS
{% endif %}
{% if xnat_dev_plugins | length %}
{#- devPlugins rather than pluginInstaller.s3.syncPrefix: the chart renders it
    after the plugins: map, so a locally built jar overrides a declared plugin of
    the same name. syncPrefix runs first and is for installing a release set. #}
devPlugins:
  enabled: true
  s3Uri: 's3://{{ xnat_dev_bucket }}/plugins/'
{% endif %}

{# --- extraConfig: merged from all extraConfig blocks + base xnat_extra_config --#}
{% set extra = {} %}
{% for k, v in (xnat_extra_config | default({})).items() %}{% set _ = extra.update({k: v}) %}{% endfor %}
{% for p in xnat_plugins_all %}
{% for c in p.config | default([]) %}
{% if c.mechanism == 'extraConfig' %}
{% for k, v in c.properties.items() %}{% set _ = extra.update({k: v}) %}{% endfor %}
{% endif %}
{% endfor %}
{% endfor %}
{# Dev-only: point XNAT at the standalone broker deployed by tasks/dev_activemq.yaml. #}
{% if xnat_dev_activemq | bool %}
{% set _ = extra.update({'spring.activemq.broker-url': 'tcp://xnat-activemq:61616', 'spring.activemq.user': xnat_dev_activemq_user, 'spring.activemq.password': xnat_dev_activemq_password}) %}
{% endif %}
{% if extra %}
extraConfig:
{% for k, v in extra.items() %}
  {{ k | string | to_json }}: {{ v | string | to_json }}
{% endfor %}
{% endif %}

{# --- extraVolumes: prefs-init + file-config Secrets. Plugin jar Secrets and the
     installer's CA are declared on the plugins/pluginInstaller values above, so
     the chart mounts those itself. --#}
extraVolumes:
  - name: prefs-init
    secret:
      secretName: xnat-prefs-init
{% for p in xnat_plugins_all %}
{% for c in p.config | default([]) if c.mechanism == 'file' %}
  - name: cfg-{{ p.name }}-{{ loop.index }}
    secret:
      # `| lower` matches the Secret name built in tasks/create_secrets.yaml
      # (k8s Secret names must be lowercase RFC 1123) — keep them in sync.
      secretName: xnat-plugin-{{ p.name }}-cfg-{{ c.dest | basename | regex_replace('[^A-Za-z0-9]', '-') | lower }}
{% endfor %}
{% endfor %}

extraVolumeMounts:
  - name: prefs-init
    mountPath: /data/xnat/home/config/prefs-init.ini
    subPath: prefs-init.ini
{% for p in xnat_plugins_all %}
{% for c in p.config | default([]) if c.mechanism == 'file' %}
  - name: cfg-{{ p.name }}-{{ loop.index }}
    mountPath: /data/xnat/home/{{ c.dest }}
    subPath: {{ c.dest | basename }}
    readOnly: true
{% endfor %}
{% endfor %}

{% if xnat_dev_war | length %}
devWar:
  enabled: true
  source: s3
  s3Uri: 's3://{{ xnat_dev_bucket }}/ROOT.war'
{% endif %}
