{{/* The Scout realm, and the only copy of it. Rendered through helm `tpl`
     by the chart's realms.yaml, then published as a ConfigMap for the app
     manager to compose with the discovered fragments (ADR 0037). Both the
     Ansible and the GitOps lane install this same file; they differ only in
     where the values below come from.

     The $(env:...) tokens are not helm's -- keycloak-config-cli substitutes
     them from the apply Job's environment, which is how credentials and the
     site hostname stay out of this document. */}}
{
    "enabled": true,
    "realm": "{{ .Values.realmName }}",
    "displayName": "{{ .Values.realmName | title }}",
    {{- /* userProfileEnabled gates whether keycloak-config-cli imports the
        userProfile block below. Without this realm attribute, the importer
        logs "skipping profile import" and the userProfile section is
        silently ignored. */}}
    "attributes": {
      "userProfileEnabled": "true"
    },
    "eventsEnabled": true,
    "adminEventsEnabled": true,
    "adminEventsDetailsEnabled": true,
    "ssoSessionIdleTimeout": {{ .Values.lifespans.ssoSession }},
    "ssoSessionMaxLifespan": {{ .Values.lifespans.ssoSession }},
    {{- /* End-user access-token lifespan, set explicitly (rather than relying on
        Keycloak's matching built-in default) so consumers that must stay in
        sync with it — JupyterHub's auth_refresh_age — compute from the same
        keycloak_access_token_lifespan variable. */}}
    "accessTokenLifespan": {{ .Values.lifespans.accessToken }},
    {{- /* Realm-level session timeouts align with the oauth2-proxy cookie (8h)
        so users get one consistent session across the stack.
        Required by Keycloak 26.6+: `client.session.idle.timeout` on the
        temporal and minio clients (which don't refresh OIDC tokens, so
        they need long-lived access tokens) cannot exceed the realm's
        ssoSessionIdleTimeout. Prior 26.x versions tolerated this mismatch
        but 26.6 validates it at client create time. */}}
    "emailTheme": "scout",
    "loginTheme": "scout",
    "internationalizationEnabled": true,
    "supportedLocales": ["en"],
    "defaultLocale": "en",
    {{- /* Scout Terms of Use text overrides for the "en" locale. Imported by
        keycloak-config-cli into realm localization texts; the
        ScoutTermsRequiredAction SPI reads `termsBody` at request time via
        getRealmLocalizationTextsByLocale. Empty dict is valid — SPI falls
        back to the scout login theme's baked-in messages_en.properties. */}}
    "messageBundles": {
      "en": {{ .Values.termsLocalizations | default dict | toJson }}
    },
    "eventsListeners": [
      "user-approval-email",
      {{- /* ADR 0021: consumes USER admin events to keep its in-memory snapshot
          in sync; uses event.getDetails() (gated by adminEventsDetailsEnabled
          at the top of this realm) on DELETE to recover the deleted user's
          username, since the user row is gone by event-fire time. */}}
      "opa-user-bundle-publisher",
      "jboss-logging"
    ],
    "smtpServer": {
      "debug": "{{ .Values.smtp.debug }}",
      "replyToDisplayName": "{{ .Values.smtp.replyToDisplayName }}",
      "starttls": "{{ .Values.smtp.starttls }}",
      "auth": "{{ .Values.smtp.auth }}",
      "port": "{{ .Values.smtp.port }}",
      "host": "{{ .Values.smtp.host }}",
      "replyTo": "{{ .Values.smtp.replyTo }}",
      "from": "{{ .Values.smtp.from }}",
      "fromDisplayName": "{{ .Values.smtp.fromDisplayName }}",
      "envelopeFrom": "{{ .Values.smtp.envelopeFrom }}",
      "ssl": "{{ .Values.smtp.ssl }}"
    },
    "roles": {
      "client": {
        "oauth2-proxy": [
          {
            "name": "oauth2-proxy-user",
            "description": "Scout User Role for OAuth2 Proxy Client",
            "composite": false,
            "clientRole": true,
            "attributes": {}
          }
        ],
        "jupyterhub": [
          {
            "name": "jupyterhub-admin",
            "description": "Scout Admin Role for JupyterHub Client",
            "composite": false,
            "clientRole": true,
            "attributes": {}
          },
          {
            "name": "jupyterhub-user",
            "description": "Scout User Role for JupyterHub Client",
            "composite": false,
            "clientRole": true,
            "attributes": {}
          }
        ],
        "superset": [
          {
            "name": "superset_admin",
            "description": "Superset Admin role",
            "composite": false,
            "clientRole": true,
            "attributes": {}
          },
          {
            "name": "superset_alpha",
            "description": "Superset Alpha role",
            "composite": false,
            "clientRole": true,
            "attributes": {}
          },
          {
            "name": "superset_gamma",
            "description": "Superset Gamma role",
            "composite": false,
            "clientRole": true,
            "attributes": {}
          },
          {
            "name": "superset_sql_lab",
            "description": "Superset sql_lab role",
            "composite": false,
            "clientRole": true,
            "attributes": {}
          }
        ],
        "grafana": [
          {
            "name": "grafana-admin",
            "description": "Scout Admin Role for Grafana Client",
            "composite": false,
            "clientRole": true,
            "attributes": {}
          },
          {
            "name": "grafana-editor",
            "description": "Scout Editor Role for Grafana Client",
            "composite": false,
            "clientRole": true,
            "attributes": {}
          },
          {
            "name": "grafana-viewer",
            "description": "Scout Viewer Role for Grafana Client",
            "composite": false,
            "clientRole": true,
            "attributes": {}
          }
        ],
        "temporal": [
          {
            "name": "temporal-system:admin",
            "description": "Scout Admin Role for Temporal System",
            "composite": false,
            "clientRole": true,
            "attributes": {}
          },
          {
            "name": "default:admin",
            "description": "Scout Admin Role for Temporal Default Namespace",
            "composite": false,
            "clientRole": true,
            "attributes": {}
          }
        ],
        {{- /* MinIO's vocabulary is closed: `consoleAdmin` is a MinIO built-in canned
            policy, so the role name IS the value MinIO wants in its `policy` claim. */}}
        "minio": [
          {
            "name": "consoleAdmin",
            "description": "MinIO canned policy granted to Scout admins",
            "composite": false,
            "clientRole": true,
            "attributes": {}
          }
        ],
        "open-webui": [
          {
            "name": "open-webui-admin",
            "description": "Scout Admin Role for Open WebUI Client",
            "composite": false,
            "clientRole": true,
            "attributes": {}
          },
          {
            "name": "open-webui-user",
            "description": "Scout User Role for Open WebUI Client",
            "composite": false,
            "clientRole": true,
            "attributes": {}
          }
        ],
        "launchpad": [
          {
            "name": "launchpad-admin",
            "description": "Scout Admin Role for Launchpad Client",
            "composite": false,
            "clientRole": true,
            "attributes": {}
          },
          {
            "name": "launchpad-user",
            "description": "Scout User Role for Launchpad Client",
            "composite": false,
            "clientRole": true,
            "attributes": {}
          }
        ]{{- if eq (.Values.enableXnat | toString) "true" }},
        "xnat": [
          {
            "name": "xnat-access",
            "description": "Scout User Role for XNAT Client",
            "composite": false,
            "clientRole": true,
            "attributes": {}
          }
        ]{{- end }}
      }
    },
    "groups": [
      {
        "name": "scout-admin",
        {{- /* Declared empty, not omitted, to retract the old
            `policy: [consoleAdmin]` attribute. Its value now lives as a MinIO
            client role, granted below. No group in this realm carries attributes. */}}
        "attributes": {},
        "clientRoles": {
          "oauth2-proxy": [
            "oauth2-proxy-user"
          ],
          "jupyterhub": [
            "jupyterhub-admin"
          ],
          "launchpad": [
            "launchpad-admin"
          ],
          "superset": [
            "superset_admin"
          ],
          "grafana": [
            "grafana-admin"
          ],
          "temporal": [
            "temporal-system:admin",
            "default:admin"
          ],
          "open-webui": [
            "open-webui-admin"
          ],
          "minio": [
            "consoleAdmin"
          ],
          {{- /* This lets a site admin use the Keycloak console.
              TODO: Narrow realm-admin (a composite role with more permissions than
              an admin likely needs) to a finer-grained set of roles. */}}
          "realm-management": [
            "realm-admin"
          ]
        }
      },
      {
        "name": "scout-user",
        "clientRoles": {
          "oauth2-proxy": [
            "oauth2-proxy-user"
          ],
          "jupyterhub": [
            "jupyterhub-user"
          ],
          "launchpad": [
            "launchpad-user"
          ],
          "superset": [
            "superset_gamma",
            "superset_sql_lab"
          ],
          "open-webui": [
            "open-webui-user"
          ]{{- if eq (.Values.enableXnat | toString) "true" }},
          "xnat": [
            "xnat-access"
          ]{{- end }}
        }
      }
    ],
    "clients": [
      {
        "name": "oauth2-proxy",
        "description": "OAuth2 Proxy Client",
        "enabled": true,
        "fullScopeAllowed": false,
        "clientId": "oauth2-proxy",
        "clientAuthenticatorType": "client-secret",
        "secret": "$(env:oauth2_proxy)",
        "redirectUris": [
          "https://auth.$(env:server_hostname)/oauth2/callback"{{- range $h := (splitList "," .Values.albOidcHosts) }}{{- $h = trim $h }}{{- if $h }},
          "https://{{ $h }}/oauth2/idpresponse"{{- end }}{{- end }}
        ],
        "webOrigins": [
          "https://auth.$(env:server_hostname)"{{- range $h := (splitList "," .Values.albOidcHosts) }}{{- $h = trim $h }}{{- if $h }},
          "https://{{ $h }}"{{- end }}{{- end }}
        ],
        "attributes": {
          "post.logout.redirect.uris": "https://$(env:server_hostname)"
        },
        "defaultClientScopes": [
          "web-origins",
          "acr",
          "profile",
          "roles",
          "basic",
          "email"
        ],
        "optionalClientScopes": [
          "address",
          "phone",
          "organization",
          "offline_access"
        ]
      },
      {
        "name": "jupyterhub",
        "description": "JupyterHub Client",
        "enabled": true,
        "fullScopeAllowed": false,
        "clientId": "jupyterhub",
        "clientAuthenticatorType": "client-secret",
        "secret": "$(env:jupyterhub)",
        "redirectUris": [
          "https://jupyter.$(env:server_hostname)/hub/oauth_callback",
          "https://auth.$(env:server_hostname)/oauth2/sign_out"
        ],
        "webOrigins": [
          "https://jupyter.$(env:server_hostname)"
        ],
        {{- /* trino-audience scope adds aud=trino to access tokens so notebooks
            can forward the user's JupyterHub token directly to Trino (JWT
            pass-through, ADR 0022). The notebook pod never holds the token
            long-term — the scout_trino helper fetches a current value from
            the Hub via JUPYTERHUB_API_TOKEN (Hub refreshes via auth_state
            on demand), so realm-default access-token TTL is fine. */}}
        "protocolMappers": [
          {
            "name": "client-roles",
            "protocol": "openid-connect",
            "protocolMapper": "oidc-usermodel-client-role-mapper",
            "consentRequired": false,
            "config": {
              "usermodel.clientRoleMapping.clientId": "jupyterhub",
              "claim.name": "groups",
              "multivalued": "true",
              "jsonType.label": "String",
              "id.token.claim": "true",
              "access.token.claim": "true",
              "userinfo.token.claim": "true",
              "introspection.token.claim": "true"
            }
          }
        ],
        "defaultClientScopes": [
          "web-origins",
          "acr",
          "profile",
          "roles",
          "basic",
          "email",
          "trino-audience"
        ],
        "optionalClientScopes": [
          "address",
          "phone",
          "organization",
          "offline_access"
        ]
      },
      {
        "name": "grafana",
        "description": "Grafana Client",
        "enabled": true,
        "fullScopeAllowed": false,
        "clientId": "grafana",
        "clientAuthenticatorType": "client-secret",
        "secret": "$(env:grafana)",
        "redirectUris": [
          "https://grafana.$(env:server_hostname)/login/generic_oauth",
          "https://auth.$(env:server_hostname)/oauth2/sign_out"
        ],
        "webOrigins": [
          "https://grafana.$(env:server_hostname)"
        ],
        {{- /* Grafana's role_attribute_path is JMESPath over the ID token and userinfo,
            so both must carry it. */}}
        "protocolMappers": [
          {
            "name": "client-roles",
            "protocol": "openid-connect",
            "protocolMapper": "oidc-usermodel-client-role-mapper",
            "consentRequired": false,
            "config": {
              "usermodel.clientRoleMapping.clientId": "grafana",
              "claim.name": "groups",
              "multivalued": "true",
              "jsonType.label": "String",
              "id.token.claim": "true",
              "access.token.claim": "true",
              "userinfo.token.claim": "true",
              "introspection.token.claim": "true"
            }
          }
        ],
        "defaultClientScopes": [
          "web-origins",
          "acr",
          "profile",
          "roles",
          "basic",
          "email"
        ],
        "optionalClientScopes": [
          "address",
          "phone",
          "organization",
          "offline_access"
        ]
      },
      {
        "name": "temporal",
        "description": "Temporal Client",
        "enabled": true,
        "fullScopeAllowed": false,
        "clientId": "temporal",
        "clientAuthenticatorType": "client-secret",
        "secret": "$(env:temporal)",
        "redirectUris": [
          "https://temporal.$(env:server_hostname)/auth/sso/callback",
          "https://auth.$(env:server_hostname)/oauth2/sign_out"
        ],
        "webOrigins": [
          "https://temporal.$(env:server_hostname)"
        ],
        "attributes": {
          "access.token.lifespan": "{{ .Values.lifespans.temporalToken | default .Values.lifespans.ssoSession }}",
          "client.session.idle.timeout": "{{ .Values.lifespans.temporalToken | default .Values.lifespans.ssoSession }}",
          "client.session.max.lifespan": "{{ .Values.lifespans.temporalToken | default .Values.lifespans.ssoSession }}",
          "client.offline.session.idle.timeout": "{{ .Values.lifespans.temporalToken | default .Values.lifespans.ssoSession }}"
        },
        {{- /* Temporal's default claim mapper parses <namespace>:<role> strings, so its
            role names ARE its permission strings and the claim it reads is
            `permissions`, not `groups`. */}}
        "protocolMappers": [
          {
            "name": "client-roles",
            "protocol": "openid-connect",
            "protocolMapper": "oidc-usermodel-client-role-mapper",
            "consentRequired": false,
            "config": {
              "usermodel.clientRoleMapping.clientId": "temporal",
              "claim.name": "permissions",
              "multivalued": "true",
              "jsonType.label": "String",
              "id.token.claim": "true",
              "access.token.claim": "true",
              "userinfo.token.claim": "true",
              "introspection.token.claim": "true"
            }
          }
        ],
        "defaultClientScopes": [
          "web-origins",
          "acr",
          "profile",
          "roles",
          "basic",
          "email"
        ],
        "optionalClientScopes": [
          "address",
          "phone",
          "organization",
          "offline_access"
        ]
      },
      {
        "name": "superset",
        "description": "Superset Client",
        "enabled": true,
        "fullScopeAllowed": false,
        "clientId": "superset",
        "clientAuthenticatorType": "client-secret",
        "secret": "$(env:superset)",
        "redirectUris": [
          "https://superset.$(env:server_hostname)/oauth-authorized/keycloak",
          "https://auth.$(env:server_hostname)/oauth2/sign_out"
        ],
        "webOrigins": [
          "https://superset.$(env:server_hostname)"
        ],
        {{- /* userinfo.token.claim is load-bearing: Flask-AppBuilder's Keycloak handler
            reads role_keys from the userinfo response, not from the token. */}}
        "protocolMappers": [
          {
            "name": "client-roles",
            "protocol": "openid-connect",
            "protocolMapper": "oidc-usermodel-client-role-mapper",
            "consentRequired": false,
            "config": {
              "usermodel.clientRoleMapping.clientId": "superset",
              "claim.name": "groups",
              "multivalued": "true",
              "jsonType.label": "String",
              "id.token.claim": "true",
              "access.token.claim": "true",
              "userinfo.token.claim": "true",
              "introspection.token.claim": "true"
            }
          }
        ],
        "defaultClientScopes": [
          "web-origins",
          "acr",
          "profile",
          "roles",
          "basic",
          "email"
        ],
        "optionalClientScopes": [
          "address",
          "phone",
          "organization",
          "offline_access"
        ]
      },
      {
        "name": "minio",
        "description": "Minio Client",
        "enabled": true,
        "fullScopeAllowed": false,
        "clientId": "minio",
        "clientAuthenticatorType": "client-secret",
        "secret": "$(env:minio)",
        "redirectUris": [
          "https://minio.$(env:server_hostname)/oauth_callback",
          "https://auth.$(env:server_hostname)/oauth2/sign_out"
        ],
        "webOrigins": [
          "https://minio.$(env:server_hostname)"
        ],
        "attributes": {
          "access.token.lifespan": "{{ .Values.lifespans.minioToken | default .Values.lifespans.ssoSession }}",
          "client.session.idle.timeout": "{{ .Values.lifespans.minioToken | default .Values.lifespans.ssoSession }}",
          "client.session.max.lifespan": "{{ .Values.lifespans.minioToken | default .Values.lifespans.ssoSession }}",
          "client.offline.session.idle.timeout": "{{ .Values.lifespans.minioToken | default .Values.lifespans.ssoSession }}"
        },
        {{- /* MinIO's default MINIO_IDENTITY_OPENID_CLAIM_NAME is `policy` and the role
            name is the canned-policy name. id.token.claim must stay true: MinIO's web
            identity flow presents the ID token. */}}
        "protocolMappers": [
          {
            "name": "client-roles",
            "protocol": "openid-connect",
            "protocolMapper": "oidc-usermodel-client-role-mapper",
            "consentRequired": false,
            "config": {
              "usermodel.clientRoleMapping.clientId": "minio",
              "claim.name": "policy",
              "multivalued": "true",
              "jsonType.label": "String",
              "id.token.claim": "true",
              "access.token.claim": "true",
              "userinfo.token.claim": "true",
              "introspection.token.claim": "true"
            }
          }
        ],
        "defaultClientScopes": [
          "web-origins",
          "acr",
          "profile",
          "roles",
          "basic",
          "email"
        ],
        "optionalClientScopes": [
          "address",
          "phone",
          "organization",
          "offline_access"
        ]
      },
      {
        "name": "launchpad",
        "description": "Launchpad Client",
        "enabled": true,
        "fullScopeAllowed": false,
        "clientId": "launchpad",
        "clientAuthenticatorType": "client-secret",
        "secret": "$(env:launchpad_client)",
        "redirectUris": [
          "https://$(env:server_hostname)/api/auth/callback/keycloak",
          "https://auth.$(env:server_hostname)/oauth2/sign_out"
        ],
        "webOrigins": [
          "https://$(env:server_hostname)"
        ],
        {{- /* aud=scout-users-api so the scout-users SPI — which can grant scout-admin
            -> realm-admin — accepts only tokens minted for the launchpad, as
            defense in depth on top of its live scout-admin check. Audiences the SPI
            itself; the -api suffix keeps it distinct from the scout-user group.
            Same shape as trino-audience. */}}
        "protocolMappers": [
          {
            "name": "client-roles",
            "protocol": "openid-connect",
            "protocolMapper": "oidc-usermodel-client-role-mapper",
            "consentRequired": false,
            "config": {
              "usermodel.clientRoleMapping.clientId": "launchpad",
              "claim.name": "groups",
              "multivalued": "true",
              "jsonType.label": "String",
              "id.token.claim": "true",
              "access.token.claim": "true",
              "userinfo.token.claim": "true",
              "introspection.token.claim": "true"
            }
          },
          {
            "name": "scout-users-api-audience-mapper",
            "protocol": "openid-connect",
            "protocolMapper": "oidc-audience-mapper",
            "consentRequired": false,
            "config": {
              "included.custom.audience": "scout-users-api",
              "id.token.claim": "false",
              "access.token.claim": "true",
              "introspection.token.claim": "true",
              "lightweight.claim": "false"
            }
          }
        ],
        "defaultClientScopes": [
          "web-origins",
          "acr",
          "profile",
          "roles",
          "basic",
          "email"
        ],
        "optionalClientScopes": [
          "address",
          "phone",
          "organization",
          "offline_access"
        ]
      },
      {
        "name": "open-webui",
        "description": "Open WebUI Client",
        "enabled": true,
        "fullScopeAllowed": false,
        "clientId": "open-webui",
        "clientAuthenticatorType": "client-secret",
        "secret": "$(env:open_webui)",
        "redirectUris": [
          "https://chat.$(env:server_hostname)/oauth/oidc/callback",
          "https://auth.$(env:server_hostname)/oauth2/sign_out"
        ],
        "webOrigins": [
          "https://chat.$(env:server_hostname)"
        ],
        {{- /* Audience scope the OWUI user token carries to report-viewer
            on the user's behalf (ADR 0022). report-viewer validates
            required-audience=report-viewer on inbound Bearer tokens
            from the OWUI tool runtime. */}}
        "protocolMappers": [
          {
            "name": "client-roles",
            "protocol": "openid-connect",
            "protocolMapper": "oidc-usermodel-client-role-mapper",
            "consentRequired": false,
            "config": {
              "usermodel.clientRoleMapping.clientId": "open-webui",
              {{- /* claim.name=groups matches OAUTH_ROLES_CLAIM=groups,
                  read from both the access and ID tokens. */}}
              "claim.name": "groups",
              "multivalued": "true",
              "jsonType.label": "String",
              "id.token.claim": "true",
              "access.token.claim": "true",
              "userinfo.token.claim": "true",
              "introspection.token.claim": "true"
            }
          }
        ],
        "defaultClientScopes": [
          "web-origins",
          "acr",
          "profile",
          "roles",
          "basic",
          "email",
          "report-viewer-audience"
        ],
        "optionalClientScopes": [
          "address",
          "phone",
          "organization",
          "offline_access"
        ]
      },
      {{- /* Service principals for the Trino client surfaces. Each
          authenticates to Trino via client_credentials and impersonates
          the end user via X-Trino-User. Token lifespan is 4h so
          long-running notebook/dashboard queries don't expire mid-
          session (per-user offboarding still propagates within seconds
          via the OPA bundle pull — see ADR 0021). */}}
      {
        "name": "superset_svc",
        "description": "Service principal for Superset connecting to Trino (impersonates the logged-in user via X-Trino-User)",
        "enabled": true,
        "fullScopeAllowed": false,
        "clientId": "superset_svc",
        "clientAuthenticatorType": "client-secret",
        "secret": "$(env:superset_svc)",
        "serviceAccountsEnabled": true,
        "standardFlowEnabled": false,
        "directAccessGrantsEnabled": false,
        "publicClient": false,
        "protocol": "openid-connect",
        "attributes": {
          "access.token.lifespan": "{{ .Values.lifespans.trinoServiceToken }}"
        },
        "defaultClientScopes": [
          "web-origins",
          "acr",
          "profile",
          "roles",
          "basic",
          "email",
          "trino-audience"
        ]
      },
      {
        "name": "voila_svc",
        "description": "Service principal for Voila playbooks impersonating the OIDC-authenticated user via X-Trino-User",
        "enabled": true,
        "fullScopeAllowed": false,
        "clientId": "voila_svc",
        "clientAuthenticatorType": "client-secret",
        "secret": "$(env:voila_svc)",
        "serviceAccountsEnabled": true,
        "standardFlowEnabled": false,
        "directAccessGrantsEnabled": false,
        "publicClient": false,
        "protocol": "openid-connect",
        "attributes": {
          "access.token.lifespan": "{{ .Values.lifespans.trinoServiceToken }}"
        },
        "defaultClientScopes": [
          "web-origins",
          "acr",
          "profile",
          "roles",
          "basic",
          "email",
          "trino-audience"
        ]
      },
      {
        "name": "report_viewer_svc",
        "description": "Service principal for report-viewer impersonating the chat/iframe user via X-Trino-User",
        "enabled": true,
        "fullScopeAllowed": false,
        "clientId": "report_viewer_svc",
        "clientAuthenticatorType": "client-secret",
        "secret": "$(env:report_viewer_svc)",
        "serviceAccountsEnabled": true,
        "standardFlowEnabled": false,
        "directAccessGrantsEnabled": false,
        "publicClient": false,
        "protocol": "openid-connect",
        "attributes": {
          "access.token.lifespan": "{{ .Values.lifespans.trinoServiceToken }}"
        },
        "defaultClientScopes": [
          "web-origins",
          "acr",
          "profile",
          "roles",
          "basic",
          "email",
          "trino-audience"
        ]
      }{{- if eq (.Values.enableXnat | toString) "true" }},
      {
        "name": "xnat",
        "description": "XNAT Client",
        "enabled": true,
        "fullScopeAllowed": false,
        "clientId": "xnat",
        "clientAuthenticatorType": "client-secret",
        "secret": "$(env:xnat)",
        "redirectUris": [
          "https://xnat.$(env:server_hostname)/openid-login",
          "https://auth.$(env:server_hostname)/oauth2/sign_out"
        ],
        "webOrigins": [
          "https://xnat.$(env:server_hostname)"
        ],
        "attributes": {
          "pkce.code.challenge.method": "S256"
        },
        "protocolMappers": [
          {
            "name": "client-roles",
            "protocol": "openid-connect",
            "protocolMapper": "oidc-usermodel-client-role-mapper",
            "consentRequired": false,
            "config": {
              "usermodel.clientRoleMapping.clientId": "xnat",
              "claim.name": "groups",
              "multivalued": "true",
              "jsonType.label": "String",
              "id.token.claim": "true",
              "access.token.claim": "true",
              "userinfo.token.claim": "true",
              "introspection.token.claim": "true"
            }
          }
        ],
        "defaultClientScopes": [
          "web-origins",
          "acr",
          "profile",
          "roles",
          "basic",
          "email"
        ],
        "optionalClientScopes": [
          "address",
          "phone",
          "organization",
          "offline_access"
        ]
      }{{- end }}
    ],
    "identityProviders": [
        {{- if eq (.Values.github.enabled | toString) "true" }}
        {
          "alias": "github",
          "providerId": "github",
          "displayName": "GitHub",
          "enabled": true,
          "trustEmail": true,
          "config": {
            "clientId": "$(env:github_client_id)",
            "clientSecret": "$(env:github_client_secret)"
          }
        }
        {{- end }}
        {{- if eq (.Values.microsoft.enabled | toString) "true" }}
        {{- if eq (.Values.github.enabled | toString) "true" }},{{- end }}
        {
          "alias": "microsoft",
          "providerId": "microsoft",
          "displayName": "Microsoft",
          "enabled": true,
          "trustEmail": true,
          "config": {
            "clientId": "$(env:microsoft_client_id)",
            "clientSecret": "$(env:microsoft_client_secret)",
            "tenantId": "$(env:microsoft_tenant_id)"
          }
        }
        {{- end }}
    ],
    "authenticationFlows": [
      {
        "alias": "browser",
        "description": "Browser based authentication",
        "providerId": "basic-flow",
        "topLevel": true,
        "builtIn": true,
        "authenticationExecutions": [
          {
            "authenticator": "auth-cookie",
            "authenticatorFlow": false,
            "requirement": "ALTERNATIVE",
            "priority": 10,
            "autheticatorFlow": false,
            "userSetupAllowed": false
          },
          {
            "authenticator": "auth-spnego",
            "authenticatorFlow": false,
            "requirement": "DISABLED",
            "priority": 20,
            "autheticatorFlow": false,
            "userSetupAllowed": false
          },
          {
            "authenticatorConfig": "default-provider",
            "authenticator": "identity-provider-redirector",
            "authenticatorFlow": false,
            "requirement": "ALTERNATIVE",
            "priority": 25,
            "autheticatorFlow": false,
            "userSetupAllowed": false
          },
          {
            "authenticatorFlow": true,
            "requirement": "ALTERNATIVE",
            "priority": 26,
            "autheticatorFlow": true,
            "flowAlias": "Organization",
            "userSetupAllowed": false
          },
          {
            "authenticatorFlow": true,
            "requirement": "ALTERNATIVE",
            "priority": 30,
            "autheticatorFlow": true,
            "flowAlias": "forms",
            "userSetupAllowed": false
          }
        ]
      }
    ],
    {{- $idps := list }}
    {{- if eq (.Values.github.enabled | toString) "true" }}{{- $idps = append $idps "github" }}{{- end }}
    {{- if eq (.Values.microsoft.enabled | toString) "true" }}{{- $idps = append $idps "microsoft" }}{{- end }}
    {{- /* Only meaningful once something is brokered: a site with no external IdP
           logs in against the realm itself, and defaultProvider names nothing. */}}
    {{- if and $idps (not (has .Values.defaultProvider $idps)) }}{{- fail (printf "keycloak realm: defaultProvider %q is not an enabled IdP (github.enabled=%v microsoft.enabled=%v)" .Values.defaultProvider .Values.github.enabled .Values.microsoft.enabled) }}{{- end }}
    "authenticatorConfig": [
      {
        "alias": "default-provider",
        "config": {
          "defaultProvider": "{{ .Values.defaultProvider }}"
        }
      }
    ],
    {{- /* User-profile config: full-replace semantics via keycloak-config-cli
        (Scout owns this block). First four attrs are the Keycloak 26.x
        defaults reproduced verbatim; last three are Scout-managed. Declaring
        the Scout attrs as "managed" (view/edit permissioned, grouped) makes
        them admin-visible regardless of the realm's unmanagedAttributePolicy.
        ScoutTermsRequiredAction writes to them via UserModel.setSingleAttribute,
        which bypasses user-profile permissions and goes direct to JpaUserProvider. */}}
    "userProfile": {
      "attributes": [
        {
          "name": "username",
          "displayName": "${username}",
          "validations": {
            "length": {"min": 3, "max": 255},
            "username-prohibited-characters": {},
            "up-username-not-idn-homograph": {}
          },
          "permissions": {
            "view": ["admin", "user"],
            "edit": ["admin", "user"]
          },
          "multivalued": false
        },
        {
          "name": "email",
          "displayName": "${email}",
          "validations": {
            "email": {},
            "length": {"max": 255}
          },
          "required": {
            "roles": ["user"]
          },
          "permissions": {
            "view": ["admin", "user"],
            "edit": ["admin", "user"]
          },
          "multivalued": false
        },
        {
          "name": "firstName",
          "displayName": "${firstName}",
          "validations": {
            "length": {"max": 255},
            "person-name-prohibited-characters": {}
          },
          "permissions": {
            "view": ["admin", "user"],
            "edit": ["admin", "user"]
          },
          "multivalued": false
        },
        {
          "name": "lastName",
          "displayName": "${lastName}",
          "validations": {
            "length": {"max": 255},
            "person-name-prohibited-characters": {}
          },
          "permissions": {
            "view": ["admin", "user"],
            "edit": ["admin", "user"]
          },
          "multivalued": false
        },
        {
          "name": "scout_terms_hash_accepted",
          "displayName": "Scout Terms of Use — accepted hash",
          "permissions": {
            "view": ["admin"],
            "edit": ["admin"]
          },
          "group": "scout",
          "multivalued": false
        },
        {
          "name": "scout_terms_accepted_at",
          "displayName": "Scout Terms of Use — accepted at (epoch seconds)",
          "permissions": {
            "view": ["admin"],
            "edit": ["admin"]
          },
          "group": "scout",
          "multivalued": false
        },
        {
          "name": "scout_admin_approval_email_sent_at",
          "displayName": "Scout admin approval email — sent at (epoch millis)",
          "permissions": {
            "view": ["admin"],
            "edit": ["admin"]
          },
          "group": "scout",
          "multivalued": false
        },
        {{- /* AuthZ scoping attributes consumed by the Trino OPA policy. They
            reach OPA via the user-attribute bundle the OpaUserBundlePublisher
            SPI publishes to MinIO (ADR 0021), not a per-query admin-API call.
            Rendered from `trino_attribute_filters` in scout_common/defaults so
            adding a dimension is a one-line inventory edit. Admin-only
            view/edit so only realm admins (site admins) can grant data-access
            scopes. Per-attribute display_name / value_pattern / max_length
            overrides are honored; defaults fit alphanumeric category codes
            with a `*` wildcard. */}}
{{- range $attr_name, $attr_config := .Values.trinoAttributeFilters }}
        {
          "name": "{{ $attr_name }}",
          "displayName": "{{ $attr_config.display_name | default (printf "Scout AuthZ — %s" $attr_name) }}",
          "permissions": {
            "view": ["admin"],
            "edit": ["admin"]
          },
          "group": "scout",
          "multivalued": true,
          {{- /* scoutAuthz marks this as an admin-grant data-access attribute so the
              scout-users REST resource discovers it dynamically (no hardcoded
              dimension list); inputType hints the approval UI + Keycloak console
              at the right widget. When `options` is configured the attribute
              becomes a validated pick-list, otherwise it stays free-text. */}}
          "annotations": {
            "scoutAuthz": "true",
            "inputType": "{{- if hasKey $attr_config "options" }}multiselect{{- else }}text{{- end }}"
          },
          "validations": {
            "length": {"max": {{ $attr_config.max_length | default 64 }}},
{{- if hasKey $attr_config "options" }}
            "options": {"options": {{ $attr_config.options | toJson }}}
{{- else }}
            "pattern": {
              "pattern": "{{ $attr_config.value_pattern | default "^([A-Za-z0-9 _-]+|\\\\*)$" }}",
              "error-message": "{{ $attr_config.value_pattern_error | default "Use a code (letters, digits, spaces, hyphen, underscore) or the * wildcard for all values." }}"
            }
{{- end }}
          }
        },
{{- end }}
        {
          "name": "redact_select_identifiers",
          "displayName": "Scout AuthZ — redact select identifier columns",
          "permissions": {
            "view": ["admin"],
            "edit": ["admin"]
          },
          "group": "scout",
          "multivalued": false,
          "annotations": {
            "scoutAuthz": "true",
            "inputType": "select",
            "scoutDefault": "false"
          },
          "validations": {
            "options": {
              "options": ["true", "false"]
            }
          }
        },
        {{- /* Per-user escape hatch for the data.hidden_tables block.
            Defaults to "false" (or absent) -> table-level deny applies.
            "true" means: this user is exempt from hidden_table_blocked and
            can SELECT join-target tables (e.g. patient mapping) directly.
            Intended for site operators who legitimately need full
            cross-facility introspection — set sparingly. */}}
        {
          "name": "bypass_hidden_tables",
          "displayName": "Scout AuthZ — bypass view-only table restrictions",
          "permissions": {
            "view": ["admin"],
            "edit": ["admin"]
          },
          "group": "scout",
          "multivalued": false,
          "annotations": {
            "scoutAuthz": "true",
            "inputType": "select",
            "scoutDefault": "false"
          },
          "validations": {
            "options": {
              "options": ["true", "false"]
            }
          }
        }
      ],
      "groups": [
        {
          "name": "user-metadata",
          "displayHeader": "User metadata",
          "displayDescription": "Attributes, which refer to user metadata"
        },
        {
          "name": "scout",
          "displayHeader": "Scout"
        }
      ]
    },
    {{- /* With fullScopeAllowed: false, a client is not implicitly in
        scope for the roles it defines, which is why every role-owning client
        gets an explicit self-mapping here. */}}
    "clientScopeMappings": {
      "oauth2-proxy": [
        {
          "client": "oauth2-proxy",
          "roles": ["oauth2-proxy-user"]
        }
      ],
      "jupyterhub": [
        {
          "client": "jupyterhub",
          "roles": ["jupyterhub-admin", "jupyterhub-user"]
        }
      ],
      "superset": [
        {
          "client": "superset",
          "roles": ["superset_admin", "superset_alpha", "superset_gamma", "superset_sql_lab"]
        }
      ],
      "grafana": [
        {
          "client": "grafana",
          "roles": ["grafana-admin", "grafana-editor", "grafana-viewer"]
        }
      ],
      "temporal": [
        {
          "client": "temporal",
          "roles": ["temporal-system:admin", "default:admin"]
        }
      ],
      "open-webui": [
        {
          "client": "open-webui",
          "roles": ["open-webui-admin", "open-webui-user"]
        }
      ],
      "launchpad": [
        {
          "client": "launchpad",
          "roles": ["launchpad-admin", "launchpad-user"]
        }
      ],
      "minio": [
        {
          "client": "minio",
          "roles": ["consoleAdmin"]
        }
      ]{{- if eq (.Values.enableXnat | toString) "true" }},
      "xnat": [
        {
          "client": "xnat",
          "roles": ["xnat-access"]
        }
      ]{{- end }}
    },
    "requiredActions": [
      {
        "alias": "SCOUT_TERMS",
        "name": "Accept Scout Terms of Use",
        "providerId": "SCOUT_TERMS",
        "enabled": true,
        "defaultAction": false,
        "priority": 10,
        "config": {}
      }
    ],
    {{- /* What a client gets at creation when it declares no scope lists of its own.
        If this is updated, an existing client keeps what it has. */}}
    "defaultDefaultClientScopes": [
      "acr",
      "basic",
      "email",
      "profile",
      "roles",
      "web-origins"
    ],
    "defaultOptionalClientScopes": [],
    "clientScopes": [
      {{- /* Adds aud=trino to access tokens for clients that call the Trino
          service. Trino's JWT authenticator validates required-audience=trino;
          tokens lacking this claim are rejected with 401. */}}
      {
        "name": "trino-audience",
        "description": "Adds aud=trino to access tokens for clients calling Trino",
        "protocol": "openid-connect",
        "attributes": {
          "include.in.token.scope": "false",
          "display.on.consent.screen": "false"
        },
        "protocolMappers": [
          {
            "name": "trino-audience-mapper",
            "protocol": "openid-connect",
            "protocolMapper": "oidc-audience-mapper",
            "consentRequired": false,
            "config": {
              "included.custom.audience": "trino",
              "id.token.claim": "false",
              "access.token.claim": "true",
              "introspection.token.claim": "true",
              "lightweight.claim": "false"
            }
          }
        ]
      },
      {{- /* Adds aud=report-viewer to access tokens. Report-viewer validates
          required-audience=report-viewer on inbound bearer tokens (ADR 0022).
          Any client whose users call report-viewer needs this scope in
          its default scopes. */}}
      {
        "name": "report-viewer-audience",
        "description": "Adds aud=report-viewer to access tokens for clients calling report-viewer",
        "protocol": "openid-connect",
        "attributes": {
          "include.in.token.scope": "false",
          "display.on.consent.screen": "false"
        },
        "protocolMappers": [
          {
            "name": "report-viewer-audience-mapper",
            "protocol": "openid-connect",
            "protocolMapper": "oidc-audience-mapper",
            "consentRequired": false,
            "config": {
              "included.custom.audience": "report-viewer",
              "id.token.claim": "false",
              "access.token.claim": "true",
              "introspection.token.claim": "true",
              "lightweight.claim": "false"
            }
          }
        ]
      },
      {{- /* Retired, not deleted */}}
      {
        "name": "microprofile-jwt",
        "description": "Microprofile - JWT built-in scope (retired; role delivery is per-client)",
        "protocol": "openid-connect",
        "attributes": {
          "include.in.token.scope": "true",
          "display.on.consent.screen": "false"
        },
        "protocolMappers": []
      }
    ]
  }
